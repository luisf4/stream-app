# Gerado pelo install.sh — edite se precisar e rode: docker compose up -d
SERVER_NAME=Resenha
SERVER_PASSWORD=troque-esta-senha
JWT_SECRET=troque-por-um-texto-aleatorio-longo
CHANNELS=Geral,Jogos,Filmes
# O plano grátis do Cloudflare aceita uploads de até 100 MB por requisição
MAX_UPLOAD_MB=95
# Upload da internet de casa, em Mbps (meça com um speedtest). Com ele o app divide a taxa da
# transmissão de tela entre quem está na call, em vez de estourar o upload e travar a imagem.
UPLOAD_MBPS=0

# Endereços públicos configurados no túnel (Public Hostnames)
APP_DOMAIN=resenha.seudominio.com
LIVEKIT_DOMAIN=voz.seudominio.com

# Chaves do LiveKit local (geradas pelo install.sh)
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Zero Trust → Networks → Tunnels → seu túnel → token
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...

# Cloudflare → Realtime → TURN Server → seu app TURN
CLOUDFLARE_TURN_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_TURN_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
