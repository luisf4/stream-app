{
  "name": "resenha",
  "productName": "Resenha",
  "version": "1.0.0",
  "description": "Voz, vídeo, chat e compartilhamento de tela para os amigos",
  "author": "Resenha",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "npm run helper && electron-vite dev",
    "dev:2": "npm run helper && electron-vite dev -- --profile=2",
    "helper": "node scripts/build-audio-helper.mjs",
    "build": "npm run helper && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never"
  },
  "devDependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-updater": "^6.8.9",
    "electron-vite": "^4.0.0",
    "livekit-client": "^2.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "zustand": "^5.0.0"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
