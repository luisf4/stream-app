# Copie para .env e preencha ANTES de rodar "npm run dist".
# Com os dois preenchidos, os amigos só digitam o apelido ao abrir o app.
# Deixe vazio para o app pedir endereço e senha (útil para testar com localhost:3000).

# Endereço mostrado no final do install.sh (com ou sem https://)
VITE_SERVER_URL=203-0-113-5.sslip.io

# Mesma SERVER_PASSWORD do deploy/.env
VITE_SERVER_PASSWORD=a-senha-do-servidor
