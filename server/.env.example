# Copie para .env para desenvolvimento local (todos têm valores padrão em dev)
SERVER_NAME=Resenha
SERVER_PASSWORD=amigos
# Quem digita esta senha em Configurações → Conta → "admin" vira admin (vazio = ninguém)
ADMIN_PASSWORD=troque-esta-senha-de-admin
JWT_SECRET=dev-secret-troque-isto
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_PUBLIC_URL=ws://localhost:7880
CHANNELS=Geral,Jogos,Filmes
MAX_UPLOAD_MB=100
PORT=3000
