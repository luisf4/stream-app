{
  "name": "resenha-server",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor do Resenha: login, canais, chat, uploads e tokens do LiveKit",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.13.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
